{
  "name": "personal-media-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "cf:dev": "wrangler pages dev dist --d1 MEDIA_LOG_DB --r2 MEDIA_LOG_BACKUPS",
    "db:migrate:local": "wrangler d1 migrations apply MEDIA_LOG_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply MEDIA_LOG_DB --remote",
    "wrangler:check": "wrangler pages functions build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260621.1",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "wrangler": "^4.103.0"
  }
}
